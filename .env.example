# ------------------------------------------------------------------
# Negroni — Agente de IA por WhatsApp (multi-tenant)
# Copia este archivo a ".env" y rellena los valores.
# ------------------------------------------------------------------

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Modelo por defecto (barato y rapido). Sube a sonnet para casos complejos.
AGENT_MODEL=claude-haiku-4-5-20251001

# --- WhatsApp Cloud API (Meta) ---
# Token de acceso global de la WABA (sirve de fallback para todos los tenants).
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx
# Token que TU inventas; el mismo que pondras en el panel de Meta al
# configurar el webhook (Verify Token).
WHATSAPP_VERIFY_TOKEN=negroni-verifica-2026
# Version del Graph API.
GRAPH_API_VERSION=v21.0

# --- App ---
# Carpeta con los YAML de cada cliente.
TENANTS_DIR=tenants
# Cuantos turnos recientes recordar por conversacion.
HISTORY_TURNS=12
# Base de datos local (sqlite).
DB_PATH=negroni.db
